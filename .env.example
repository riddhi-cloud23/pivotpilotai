# Copy to .env. Keep real secrets out of source control.
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./pivotpilot.db
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Server-side only. Used to verify Supabase access tokens with Auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional. Without this, deterministic demo fallbacks keep the app usable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Limits / public scan safety
MAX_UPLOAD_BYTES=5000000
MAX_SCAN_BYTES=1000000
